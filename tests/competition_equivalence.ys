design -stash comp2_gold
design -reset
read_verilog tests/competition_case/test2/test2.v
synth -top test2 -lut 4 -run begin:fine
opt -fast -full
memory_map
opt -full
pmux_opt -abc -lut 4 -no-explore
opt -fast
design -stash comp2_gate
design -copy-from comp2_gold -as gold test2
design -copy-from comp2_gate -as gate test2
equiv_make gold gate equiv_test2
hierarchy -top equiv_test2
equiv_simple
equiv_status -assert

