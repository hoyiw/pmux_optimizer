design -copy-from comp3_gate -as gate test3
equiv_make gold gate equiv_test3
hierarchy -top equiv_test3
async2sync
memory_map
equiv_simple
equiv_induct
equiv_status -assert

design -reset
read_verilog tests/competition_case/test4/test4.v
prep -top test4
design -stash comp4_gold
design -reset
read_verilog tests/competition_case/test4/test4.v
synth -top test4 -lut 4 -run begin:fine
opt -fast -full
memory_map
opt -full
pmux_opt -abc -lut 4 -no-explore
opt -fast
design -stash comp4_gate
design -copy-from comp4_gold -as gold test4
design -copy-from comp4_gate -as gate test4
equiv_make gold gate equiv_test4
hierarchy -top equiv_test4
