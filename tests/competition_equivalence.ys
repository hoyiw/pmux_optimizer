# Formal equivalence for the supplied competition cases.

design -reset
read_verilog tests/competition_case/test1/test1.v
prep -top test1
design -stash comp1_gold
design -reset
read_verilog tests/competition_case/test1/test1.v
synth -top test1 -lut 4 -run begin:fine
opt -fast -full
memory_map
opt -full
pmux_opt -abc -lut 4
opt -fast
design -stash comp1_gate
design -copy-from comp1_gold -as gold test1
design -copy-from comp1_gate -as gate test1
equiv_make gold gate equiv_test1
hierarchy -top equiv_test1
async2sync
memory_map
equiv_simple
equiv_induct
equiv_status -assert

design -reset
read_verilog tests/competition_case/test2/test2.v
